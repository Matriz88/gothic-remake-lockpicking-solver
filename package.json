{
  "name": "gothic-lockpick-solver",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.16.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "lint:check": "eslint . && prettier --check .",
